# live | snapshot | recorded
MODE=snapshot

NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
# Testnet accounts created in P0 (T0.6); keys live in ~/.near-credentials/testnet/
NEAR_ROOT_ACCOUNT=juri-assay-jdir.testnet
JURI_CONTRACT_ID=juri.juri-assay-jdir.testnet

# jury-runner
VERIFIER_KEYS_JSON={}
VERIFIER_MODELS_JSON={}
KEEPER_ACCOUNT_ID=keeper.juri-assay-jdir.testnet
KEEPER_KEY=
AUTO_START=true

# market (mainnet, read). Since 2026-11 the job board requires an agent token (aat_...)
MARKET_API_BASE=https://market.near.ai/v1
MARKET_API_KEY=

NEARBLOCKS_API_BASE=https://api.nearblocks.io
NEARBLOCKS_API_KEY=

# escrow indexer (mainnet, read). FastNEAR lists only successful txns; NearBlocks cannot filter
FASTNEAR_TX_API=https://tx.main.fastnear.com
ESCROW_ACCOUNT=escrow.ai.near
# ids that count as "the escrow" / "the fee sink" inside intents (classification heuristic)
ESCROW_INTENT_IDS=escrow.ai.near
ESCROW_FEE_ACCOUNTS=treasury.ai.near

NEARAI_BASE_URL=https://cloud-api.near.ai/v1
NEARAI_API_KEY=
FALLBACK_LLM_BASE_URL=
FALLBACK_LLM_API_KEY=

DB_PATH=./data/juri.db
BLOB_DIR=./data/blobs
PUBLIC_API_URL=http://localhost:8787
DELIVERABLE_URI_ALLOWLIST=gist.githubusercontent.com,raw.githubusercontent.com
