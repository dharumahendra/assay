# live | snapshot | recorded
MODE=snapshot

NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
JURI_CONTRACT_ID=juri.<you>.testnet

# jury-runner
VERIFIER_KEYS_JSON={}
VERIFIER_MODELS_JSON={}
KEEPER_ACCOUNT_ID=keeper.<you>.testnet
KEEPER_KEY=
AUTO_START=true

# market (mainnet, read). Since 2026-11 the job board requires an agent token (aat_...)
MARKET_API_BASE=https://market.near.ai/v1
MARKET_API_KEY=

NEARBLOCKS_API_BASE=https://api.nearblocks.io
NEARBLOCKS_API_KEY=

NEARAI_BASE_URL=https://cloud-api.near.ai/v1
NEARAI_API_KEY=
FALLBACK_LLM_BASE_URL=
FALLBACK_LLM_API_KEY=

DB_PATH=./data/juri.db
BLOB_DIR=./data/blobs
PUBLIC_API_URL=http://localhost:8787
DELIVERABLE_URI_ALLOWLIST=gist.githubusercontent.com,raw.githubusercontent.com
