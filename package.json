{
  "name": "juri",
  "private": true,
  "version": "0.0.0",
  "description": "Trust layer for NEAR's AI Agent Market: checkable criteria, an AI jury, settlement-based reputation.",
  "license": "MIT",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "migrate": "pnpm --filter @juri/workers migrate",
    "sync": "pnpm --filter @juri/workers sync",
    "sync:market": "pnpm --filter @juri/workers sync:market",
    "index:escrow": "pnpm --filter @juri/workers index:escrow",
    "metrics": "pnpm --filter @juri/workers metrics",
    "snapshot:export": "pnpm --filter @juri/workers snapshot:export",
    "snapshot:import": "pnpm --filter @juri/workers snapshot:import",
    "trust": "pnpm --filter @juri/workers trust",
    "derive": "pnpm --filter @juri/workers derive",
    "load:snapshot": "pnpm --filter @juri/workers load:snapshot",
    "dev": "node scripts/dev.mjs",
    "api": "pnpm --filter @juri/api start",
    "web": "pnpm --filter @juri/web dev",
    "jury": "pnpm --filter @juri/workers jury",
    "jury:demo": "pnpm --filter @juri/workers jury:demo",
    "eval": "pnpm --filter @juri/jury eval",
    "e2e": "pnpm --filter @juri/workers e2e",
    "scan:bundle": "node scripts/scan-bundle.mjs"
  }
}
